---
import { Font } from "astro:assets";

interface Props {
  react: string | undefined;
  astro: string | undefined;
  blog: string | undefined;
}

const { react, astro, blog } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>astro-takumi-images fixture</title>
    <meta property="og:image" content={react} />
    <Font cssVariable="--font-inter" />
  </head>
  <body>
    <img id="react" src={react} alt="" />
    <img id="astro" src={astro} alt="" />
    <img id="blog" src={blog} alt="" />
  </body>
</html>
